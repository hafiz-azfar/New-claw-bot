# Django Settings
DJANGO_SECRET_KEY=change-me-in-production-min-50-chars-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=aluloom
POSTGRES_USER=aluloom
POSTGRES_PASSWORD=aluloom_secure_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis

# MinIO (Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secure_change_me
MINIO_BUCKET=aluloom
MINIO_SECURE=False
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# LiveKit (Live Video)
LIVEKIT_URL=wss://live.aluloom.academy
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production
LIVEKIT_PORT=7880
LIVEKIT_RTC_PORT=7881
LIVEKIT_UDP_RANGE=7882-7892

# Amazon SES (Email)
SES_HOST=email-smtp.us-east-1.amazonaws.com
SES_PORT=587
SES_USERNAME=your-ses-username
SES_PASSWORD=your-ses-password
DEFAULT_FROM_EMAIL=noreply@aluloom.academy

# Listmonk (Bulk Email)
LISTMONK_API_URL=https://mail.aluloom.academy/api
LISTMONK_API_KEY=your-listmonk-api-key

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay (Payments - India)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Backend Port
BACKEND_PORT=8000
